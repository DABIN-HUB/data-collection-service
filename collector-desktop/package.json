{
  "name": "collector-desktop",
  "version": "0.1.0",
  "description": "数据采集工作台桌面客户端",
  "author": "data-collection-service",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"electron/**/*.{ts,cts}\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"eslint.config.mjs\" \"stylelint.config.mjs\" --max-warnings=0",
    "stylelint": "stylelint \"src/**/*.{css,vue}\" --max-warnings=0",
    "quality": "npm run lint && npm run stylelint && npm test && npm run typecheck",
    "verify": "npm run quality && npm run build && npm run build:web",
    "smoke:backend": "node scripts/backend-smoke.mjs",
    "smoke:device": "node scripts/device-smoke.mjs",
    "smoke:modbus": "node scripts/modbus-smoke.mjs",
    "smoke:extended": "node scripts/extended-smoke.mjs",
    "build:renderer": "vite build",
    "sync:web": "node scripts/sync-web-console.mjs",
    "build:web": "npm run build:renderer && npm run sync:web",
    "build:electron": "tsc -p tsconfig.node.json",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "vue-tsc --noEmit && npm run build:renderer && npm run build:electron",
    "electron:serve": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "electron:dev": "concurrently -k \"npm:dev\" \"npm:electron:serve\"",
    "electron:preview": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.wangbin.collector.desktop",
    "productName": "数据采集工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "collector-desktop-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
