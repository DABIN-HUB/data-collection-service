<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- 简单的彩色日志模式 -->
  <property name="COLOR_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n" disableAnsi="false"/>

  <!-- 控制台输出 -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${COLOR_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

  <!-- 业务包默认只输出告警和错误，避免采集、处理、SQL、上报成功路径刷屏。 -->
  <logger name="com.wangbin.collector" level="WARN"/>
  <!-- SQL 明细默认只在错误时输出；需要排查 SQL 时临时通过配置打开 DEBUG。 -->
  <logger name="com.wangbin.collector.mapper" level="ERROR"/>
  <logger name="com.wangbin.collector.storage.repository" level="ERROR"/>
  <logger name="org.mybatis" level="ERROR"/>
  <logger name="org.apache.ibatis" level="ERROR"/>
  <logger name="com.baomidou.mybatisplus" level="ERROR"/>

</configuration>
