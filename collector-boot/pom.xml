    </dependency>
    <dependency>
      <groupId>com.wangbin</groupId>
      <artifactId>collector-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.wangbin</groupId>
      <artifactId>collector-telemetry</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.wangbin</groupId>
      <artifactId>collector-cloud</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.wangbin</groupId>
      <artifactId>collector-storage</artifactId>
